NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
API_KEY=change-me-to-a-random-32-plus-character-secret
METRICS_API_KEY=change-me-to-a-different-random-32-plus-character-secret
CORS_ORIGIN=*
REQUEST_BODY_LIMIT=1mb
UPLOAD_MAX_FILE_BYTES=10485760
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=rag_from_zero
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
DATABASE_URL=postgres://postgres:postgres@localhost:55432/rag_from_zero
EMBEDDING_PROVIDER=fake
LLM_PROVIDER=fake
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4.1-mini
OPENAI_COMPATIBLE_TIMEOUT_MS=30000

# Use postgres for the original retrieval backend.
SEARCH_BACKEND=qdrant-elasticsearch
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=rag-chunks
OTEL_ENABLED=true
OTEL_SERVICE_NAME=rag-from-zero
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
